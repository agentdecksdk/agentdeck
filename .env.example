# Copy to .env — loaded automatically (process env wins over .env).

# --- model provider (required) ---
OPENAI_MODEL=gpt-4.1-mini
OPENAI_API_KEY=sk-...
# ⚠ defaults to a legacy private server if unset — set explicitly:
OPENAI_BASE_URL=https://api.openai.com/v1
# Set false for Chat-Completions-only servers (vLLM, Ollama, ...):
# OPENAI_USE_RESPONSES=false

# --- runner ---
# AGENTDECK_RUNNER_MAX_TURNS=30
# AGENTDECK_RUNNER_TEMPERATURE=1.0
# AGENTDECK_RUNNER_MAX_TOKENS=

# --- conversation sessions (chat memory) ---
# unset -> in-process SQLite fallback (dev only, lost on exit)
# AGENTDECK_SESSION_REDIS_URL=redis://localhost:6379/0
# AGENTDECK_SESSION_REDIS_TTL=

# --- observability (optional, needs the [observability] extra) ---
# AGENTDECK_LANGFUSE_PUBLIC_KEY=
# AGENTDECK_LANGFUSE_SECRET_KEY=
# AGENTDECK_LANGFUSE_HOST=http://localhost:3000

# --- MCP servers (optional, JSON deep-merged over YAML config) ---
# AGENTDECK_MCP_SERVERS={"docs": {"type": "http", "url": "http://..."}}

# --- workflow durability (optional; only read by workflows with durable=True) ---
# backend: sqlite | postgres | memory. sqlite/postgres need the [durability] extra.
# AGENTDECK_CHECKPOINT_BACKEND=sqlite
# AGENTDECK_CHECKPOINT_URL=
