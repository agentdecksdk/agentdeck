# Baked into the bundle at build time. Next reads this for `npm run build`, so a plain build can
# no longer ship the localhost fallback to every visitor: an unset variable here was the whole
# failure, and it is invisible until someone opens the panel in production.
# A real environment variable still wins, which is how the Pages build overrides it.
NEXT_PUBLIC_SITE_URL=https://agentdecksdk.com
NEXT_PUBLIC_AGENTDECK_API_URL=https://agentdecksdk.com
